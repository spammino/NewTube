+    private static ContinueTarget findContinueTarget(final HistoryRecordManager recordManager,
+                                                     final List<StreamInfoItem> streams) {
+        int lastWatched = -1;
+        StreamStateEntity lastState = null;
+        for (int i = 0; i < streams.size(); i++) {
+            final StreamStateEntity state =
+                    recordManager.loadStreamState(streams.get(i)).blockingGet();
+            if (state != null && state.getProgressMillis() > 0) {
+                lastWatched = i;
+                lastState = state;
+            }
+        }
+        if (lastWatched < 0) {
+            return new ContinueTarget(-1, 0);
+        }
+
+        if (lastState.isFinished(streams.get(lastWatched).getDuration())) {
+            if (lastWatched + 1 >= streams.size()) {
+                return new ContinueTarget(-1, 0); // everything loaded so far has been watched
+            }
+            return new ContinueTarget(lastWatched + 1, 0);
+        }
+        return new ContinueTarget(lastWatched, lastState.getProgressMillis());
+    }
