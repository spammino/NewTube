+                    playlistControlBinding.playlistCtrlPlayAllButton.setOnClickListener(view -> {
+                        final PlayQueue queue = getPlayQueue(target.index);
+                        queue.setRecovery(target.index, target.positionMillis);
+                        NavigationHelper.playOnMainPlayer(activity, queue);
+                    });
+                }, throwable -> {
+                    // lookup failed: just keep the normal "Play all" button
+                }));
+    }
